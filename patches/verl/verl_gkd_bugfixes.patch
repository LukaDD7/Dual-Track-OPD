Subject: [PATCH 2/5] fix: add update_weights_bucket_megabytes to RolloutConfig
 for GKD compat

GKD recipe accesses self.config.rollout.update_weights_bucket_megabytes
directly, but this verl version nests it under checkpoint_engine.
Added a flat field so both access patterns work.
---
 verl/workers/config/rollout.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/verl/workers/config/rollout.py b/verl/workers/config/rollout.py
index fa8b9573..9217f006 100644
--- a/verl/workers/config/rollout.py
+++ b/verl/workers/config/rollout.py
@@ -251,6 +251,9 @@ class RolloutConfig(BaseConfig):
     # loads this class instead of the built-in CheckpointEngineManager.
     checkpoint_manager_class: Optional[str] = None
 
+    # GKD recipe backward-compat: accessed directly as self.config.rollout.update_weights_bucket_megabytes
+    update_weights_bucket_megabytes: int = 512
+
     # Checkpoint Engine config for update weights from trainer to rollout
     checkpoint_engine: CheckpointEngineConfig = field(default_factory=CheckpointEngineConfig)
 
-- 
