From 928e862d15a395775802dad083c7e18f6b0e00c1 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 02:27:30 +0000
Subject: [PATCH 3/5] fix: pass dataclass_type to omega_conf_to_dataclass for
 model/rollout

omega_conf_to_dataclass() requires either _target_ in the config
or an explicit dataclass_type. The model config from GKD recipe
doesn't include _target_, causing AssertionError. Pass the type
explicitly for both rollout and model config creation.
---
 verl/workers/megatron_workers.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/verl/workers/megatron_workers.py b/verl/workers/megatron_workers.py
index 6693df70..4f0303c8 100644
--- a/verl/workers/megatron_workers.py
+++ b/verl/workers/megatron_workers.py
@@ -533,8 +533,8 @@ class ActorRolloutRefWorker(MegatronWorker, DistProfilerExtension):
         from torch.distributed.device_mesh import init_device_mesh
 
         # 1. parse rollout and huggingface model config
-        rollout_config: RolloutConfig = omega_conf_to_dataclass(self.config.rollout)
-        model_config: HFModelConfig = omega_conf_to_dataclass(self.config.model)
+        rollout_config: RolloutConfig = omega_conf_to_dataclass(self.config.rollout, dataclass_type=RolloutConfig)
+        model_config: HFModelConfig = omega_conf_to_dataclass(self.config.model, dataclass_type=HFModelConfig)
 
         # 2. build rollout device mesh
         infer_tp = self.config.rollout.tensor_model_parallel_size * self.config.rollout.data_parallel_size
-- 
2.43.0


From 1995ea28707c8956d9a34e64fa5bf134a2c92a46 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 02:32:08 +0000
Subject: [PATCH 4/5] fix: safe access to router_replay when actor config is
 plain dict

GKD recipe's config provides actor as a plain dict (no router_replay),
but base MegatronWorker init expects it as a structured config.
Use .get() for dict or getattr() for struct to avoid crash.
---
 verl/workers/megatron_workers.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/verl/workers/megatron_workers.py b/verl/workers/megatron_workers.py
index 4f0303c8..d5fcef30 100644
--- a/verl/workers/megatron_workers.py
+++ b/verl/workers/megatron_workers.py
@@ -325,8 +325,9 @@ class ActorRolloutRefWorker(MegatronWorker, DistProfilerExtension):
 
         self.enable_routing_replay = False
         if self._is_actor:
-            self.router_replay = self.config.actor.router_replay
-            self.enable_routing_replay = self.router_replay.mode != "disabled"
+            self.router_replay = self.config.actor.get("router_replay", None) if isinstance(self.config.actor, dict) else getattr(self.config.actor, "router_replay", None)
+            if self.router_replay is not None:
+                self.enable_routing_replay = self.router_replay.mode != "disabled"
 
         if self.enable_routing_replay:
             apply_router_replay_patch()
-- 
2.43.0


From 609f4f1bf66c9f0538a2ceeb269b39707c6c539e Mon Sep 17 00:00:00 2001
