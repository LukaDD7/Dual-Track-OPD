Date: Fri, 10 Jul 2026 03:17:04 +0000
Subject: [PATCH 5/5] =?UTF-8?q?fix:=20safe=20access=20to=20rollout.n=20?=
 =?UTF-8?q?=E2=80=94=20use=20.get()=20for=20dict/config=20compat?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GKD config YAML doesn't include n in the rollout section
(only in val_kwargs). Use dict.get() or getattr() with
default=1 for backward compat.
---
 recipe                           | 2 +-
 verl/workers/megatron_workers.py | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/recipe b/recipe
index ba246418..4af521c7 160000
--- a/recipe
+++ b/recipe
@@ -1 +1 @@
-Subproject commit ba246418f4de12b845a09bba975f1a5242adc898
+Subproject commit 4af521c7ff608c9a249ebe580cff559c123fc0e6
diff --git a/verl/workers/megatron_workers.py b/verl/workers/megatron_workers.py
index d5fcef30..702734f9 100644
--- a/verl/workers/megatron_workers.py
+++ b/verl/workers/megatron_workers.py
@@ -372,7 +372,8 @@ class ActorRolloutRefWorker(MegatronWorker, DistProfilerExtension):
 
         # normalize config
         if self._is_actor:
-            self.config.actor.ppo_mini_batch_size *= self.config.rollout.n
+            _rollout_n = self.config.rollout.get("n", 1) if isinstance(self.config.rollout, dict) else getattr(self.config.rollout, "n", 1)
+            self.config.actor.ppo_mini_batch_size *= _rollout_n
             self.config.actor.ppo_mini_batch_size //= mpu.get_data_parallel_world_size()
             if self.config.actor.get("ppo_micro_batch_size", None):
                 self.config.actor.ppo_micro_batch_size //= mpu.get_data_parallel_world_size()
-- 
