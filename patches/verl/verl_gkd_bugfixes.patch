From ce0adf93736f36620d30d02e3ea4fdf9c48d2dd8 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 02:01:28 +0000
Subject: [PATCH 1/5] fix: add no-op Profiler class for GKD recipe backward
 compat

The GKD recipe (recipe/gkd/megatron/megatron_workers.py) imports
'Profiler' which was renamed to 'DistProfiler' in this verl version.
All Profiler usage in the recipe is already commented out, so a
no-op class prevents ImportError without side effects.
---
 verl/utils/profiler/profile.py | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/verl/utils/profiler/profile.py b/verl/utils/profiler/profile.py
index d9890b2c..c0a82c47 100644
--- a/verl/utils/profiler/profile.py
+++ b/verl/utils/profiler/profile.py
@@ -308,3 +308,28 @@ class DistProfilerExtension:
     def stop_profile(self) -> None:
         """Stop profiling for the current rank in the current training step."""
         self.profiler.stop()
+
+
+# Backward-compat: GKD recipe references "Profiler" which was renamed
+# to "DistProfiler" in newer verl.  All Profiler usage in the GKD recipe
+# is commented out; this no-op class prevents ImportError.
+class Profiler:
+    """No-op profiler for backward compatibility with GKD recipe."""
+
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def start(self, *args, **kwargs):
+        pass
+
+    def stop(self, *args, **kwargs):
+        pass
+
+    def step(self, *args, **kwargs):
+        pass
+
+    def stop_and_save(self, *args, **kwargs):
+        pass
+
+    def stop_trace(self, *args, **kwargs):
+        pass
-- 
2.43.0


From 089b01aaaf81575ea7868b142440842699b33bfe Mon Sep 17 00:00:00 2001
