+        kl_s_m = (student_topk_probs * (student_topk_log_probs - m_log_probs)).sum(-1) + (
+            p_tail_s * (p_tail_s.log() - m_tail_log)
+        )
+        kl_t_m = (teacher_probs_at_student * (teacher_lp_at_student - m_log_probs)).sum(-1) + (
+            p_tail_t * (p_tail_t.log() - m_tail_log)
+        )
+        distillation_losses = 0.5 * (kl_s_m + kl_t_m)
+    elif kl_direction == "forward_kl":
+        distillation_losses = (student_topk_probs * (student_topk_log_probs - teacher_lp_at_student)).sum(-1) + (
+            p_tail_s * (p_tail_s.log() - p_tail_t.log())
+        )
+    elif kl_direction == "reverse_kl":
+        distillation_losses = (
+            teacher_probs_at_student * (teacher_lp_at_student - student_topk_log_probs)
+        ).sum(-1) + (p_tail_t * (p_tail_t.log() - p_tail_s.log()))
+    else:
