+        # Qwen3VLTextModel expects the [4, B, seq] layout (text/time/height/width
+        # on axis 0) and does not recompute positions, so transpose here.
+        sub_teacher_pos = data.get("hint_teacher_position_ids", hint_position_ids)[hint_rows].to(device)
+        if sub_teacher_pos.dim() == 3:
+            teacher_pos = sub_teacher_pos.transpose(0, 1)
+        else:
