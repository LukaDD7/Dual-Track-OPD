+
+        multi_modal_inputs = extract_multi_modal_inputs([hint_mm_raw[i] for i in hint_rows])
+        multi_modal_inputs = {
+            k: v.to(device) if isinstance(v, torch.Tensor) else v for k, v in multi_modal_inputs.items()
+        }
+        # Qwen3-VL raises if images are passed without mm_token_type_ids; rebuild it
+        # from the full teacher sequence so it is shape-consistent with teacher_ids.
+        image_token_id = getattr(getattr(self.model_config, "hf_config", None), "image_token_id", None)
+        if image_token_id is not None:
+            mm_token_type_ids = torch.zeros_like(teacher_ids)
+            mm_token_type_ids[teacher_ids == image_token_id] = 1
+            multi_modal_inputs["mm_token_type_ids"] = mm_token_type_ids
+
+        # pixel_values is concatenated across image patches ([total_patches, ...]),
+        # while image_grid_thw is per-sample ([B, 3]); slice pixel_values by the
+        # cumulative patch count of each sample so they stay consistent.
+        grids = multi_modal_inputs.get("image_grid_thw")
+        if grids is not None and "pixel_values" in multi_modal_inputs:
+            patch_lens = (grids[:, 0] * grids[:, 1] * grids[:, 2]).long()
+            patch_cum = torch.cat(
