+                _, topk_ids = torch.topk(chunk, k=top_k, dim=-1)
+                topk_log_probs = torch.gather(chunk.float(), -1, topk_ids) - log_Z
+                outs_lp.append(topk_log_probs.cpu())
+                outs_ids.append(topk_ids.cpu())
+
+        teacher_logprobs = torch.zeros((bsz, resp_len, top_k), dtype=torch.float32)
+        teacher_ids_out = torch.zeros((bsz, resp_len, top_k), dtype=torch.long)
+        teacher_logprobs[hint_rows] = torch.cat(outs_lp, dim=0)
+        teacher_ids_out[hint_rows] = torch.cat(outs_ids, dim=0)
+        return tu.get_tensordict(
+            {
+                "teacher_logprobs": teacher_logprobs,
+                "teacher_ids": teacher_ids_out,
+            }
+        )
