+        sub_attn = hint_attention_mask[hint_rows].to(device)
+        teacher_ids = torch.cat([sub_ids, sub_resp], dim=-1)
+        # Use the real response attention mask from the full student sequence.
+        # ``responses`` is right-padded; treating every padded token as valid makes
