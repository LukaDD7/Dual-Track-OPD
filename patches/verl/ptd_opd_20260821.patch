+    loss_config: DistillationLossConfig = config.distillation_loss
+    K = teacher_topk_ids.shape[-1]
+    vocab_size = loss_config.vocab_size or 150000
+    kl_direction = loss_config.kl_direction
+
+    # student top-K from logits (with grad)
+    student_log_probs = F.log_softmax(student_logits.float(), dim=-1)
+    student_topk_ids = torch.topk(student_log_probs, k=K, dim=-1).indices
