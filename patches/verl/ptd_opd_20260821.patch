+    # tail masses in fp32 for numerical stability
+    p_tail_s = (1.0 - student_topk_probs.sum(-1)).to(torch.float32).clamp(min=1e-8)
+    p_tail_t = (1.0 - teacher_probs_at_student.sum(-1)).to(torch.float32).clamp(min=1e-8)
