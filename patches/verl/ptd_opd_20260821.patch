+# Copyright 2026 Dual-Track-OPD contributors
+"""Configuration for PTD-PO (Privileged Tutoring Distillation) on verl V0.
+
+PTD complements GRPO with dense token-level supervision from a hint-augmented
+frozen reference model on failed trajectories (arXiv:2606.07000). It reuses the
+built-in top-K distillation machinery with a JSD loss mode and a custom teacher
+forward (ref model + hint context) instead of an external teacher server.
+"""
+
+from dataclasses import dataclass
+
+from verl.base_config import BaseConfig
+
+__all__ = ["PtdConfig"]
+
+
+@dataclass
+class PtdConfig(BaseConfig):
+    """PTD-PO configuration (nested under ``algorithm.ptd``)."""
+
+    enable: bool = False
+    # group-accuracy threshold: PTD activates on failed trajectories in groups
+    # whose accuracy < threshold (paper default 1.0 = all failed trajectories)
+    threshold: float = 1.0
+    # top-K support for the student/teacher distributions (paper: 100)
+    top_k: int = 100
+    # weight of the PTD JSD loss added to the GRPO policy loss (paper: 8B 5e-2)
+    coef: float = 5e-2
+    # divergence direction: "jsd_kl" (paper), or "forward_kl"/"reverse_kl"
+    kl_direction: str = "jsd_kl"
+    # True: teacher = frozen reference policy (hint-augmented). False: old-policy
+    # teacher (OPSD-style) -- not wired yet; keep True.
+    use_ref_teacher: bool = True
+    # False (paper): only failed trajectories. True: all trajectories in PTD groups.
+    all_trajectories: bool = False
+    # dataset column holding the hint-augmented chat messages
+    prompt_with_hint_key: str = "prompt_with_hint"
+    # numerical guards for the top-K JSD
+    loss_max_clamp: float = 10.0
+    log_prob_min_clamp: float = -10.0
+    # vocabulary size used for tail-mass approximation of miss tokens
+    vocab_size: int = 151936
