+            )
+        else:
+            patch_cum = None
+        autocast_dtype = getattr(self.engine, "_autocast_dtype", torch.bfloat16)
+        # Keep chunks small: a hint row can be up to prompt_length + max_response
+        # tokens, and the eager logits tensor (vocab x seq) dominates memory.
+        mb = max(1, min(2, n_hint))
+        outs_lp: list[torch.Tensor] = []
+        outs_ids: list[torch.Tensor] = []
+        with torch.no_grad():
+            for i in range(0, n_hint, mb):
+                end = min(i + mb, n_hint)
+                mm = {}
+                for k, v in multi_modal_inputs.items():
+                    if not isinstance(v, torch.Tensor):
+                        mm[k] = v
+                    elif k == "pixel_values" and patch_cum is not None:
+                        mm[k] = v[patch_cum[i] : patch_cum[end]]
+                    else:
+                        mm[k] = v[i:end]
+                with self.engine.eval_mode(disable_auto_offload=True):
+                    with torch.autocast(device_type=get_device_name(), dtype=autocast_dtype):
+                        # teacher_pos is [4, B, seq] after the transpose above
+                        # (text/time/height/width on axis 0), so the micro-batch
+                        # must be sliced on dim=1. Slicing dim=0 would instead
+                        # take the first mb mRoPE components and crash inside
+                        # Qwen3VLRotaryEmbedding with a 3-vs-mb shape mismatch.
+                        pos_batch = (
+                            teacher_pos[:, i:end] if teacher_pos.dim() == 3 else teacher_pos[i:end]
+                        )
+                        logits = self.engine.module(
+                            input_ids=teacher_ids[i:end],
+                            attention_mask=teacher_attn[i:end],
+                            position_ids=pos_batch,
+                            use_cache=False,
+                            **mm,
+                        ).logits
