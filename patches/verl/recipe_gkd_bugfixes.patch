@@ -451,7 +451,15 @@ class MegatronOnPolicyDistillActorWorker(ActorRolloutRefWorker):
     def __init__(self, config: DictConfig, role: str):
         # Ray serializes OmegaConf DictConfig, leaving nested dicts as plain dict.
         # Force-rebuild the entire config tree so attribute access works everywhere.
+        # Ray serializes OmegaConf → plain dict. Rebuild and allow dynamic keys.
         config = OmegaConf.create(OmegaConf.to_container(config, resolve=False))
+        # Disable struct mode so missing keys (e.g. rollout.n) don't raise errors
