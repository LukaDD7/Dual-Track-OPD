+        # Disable struct mode so missing keys (e.g. rollout.n) don't raise errors
+        def _unstruct(cfg):
+            OmegaConf.set_struct(cfg, False)
+            for _k, _v in cfg.items():
+                if OmegaConf.is_dict(_v):
+                    _unstruct(_v)
+        _unstruct(config)
 
