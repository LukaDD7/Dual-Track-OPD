From 916c319dacebd8055cadf4155acb9f265c4e5f97 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 03:22:49 +0000
Subject: [PATCH 5/8] fix: tokenize raw_prompt into input_ids when dataset
 lacks pre-tokenized data

Newer verl RLHFDataset only returns raw_prompt (not input_ids/
attention_mask/position_ids). GKD recipe expects pre-tokenized
inputs. Add fallback tokenization using apply_chat_template.
---
 gkd/megatron/ray_trainer.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/gkd/megatron/ray_trainer.py b/gkd/megatron/ray_trainer.py
index 533979d..0fa11c2 100644
--- a/gkd/megatron/ray_trainer.py
+++ b/gkd/megatron/ray_trainer.py
@@ -342,6 +342,24 @@ class OnPolicyDistillTrainer(RayPPOTrainer):
         Call parameter synchronization and asynchronous sequence generation.
         """
         batch = DataProto.from_single_dict(batch_dict)
+        # If dataset only provides raw_prompt (not pre-tokenized input_ids),
+        # tokenize here to produce input_ids/attention_mask for rollout generation.
+        if "input_ids" not in batch.batch and "raw_prompt" in batch.non_tensor_batch:
+            raw_prompts = batch.non_tensor_batch["raw_prompt"].tolist()
+            tokenized = self.tokenizer.apply_chat_template(
+                raw_prompts, add_generation_prompt=True, tokenize=True,
+                return_dict=True, return_tensors="pt",
+            )
+            from verl.utils.tokenizer import normalize_token_ids
+            input_ids = tokenized["input_ids"]
+            attention_mask = tokenized["attention_mask"]
+            batch.batch["input_ids"] = input_ids
+            batch.batch["attention_mask"] = attention_mask
+            position_ids = torch.arange(input_ids.shape[1]).unsqueeze(0).expand(input_ids.shape[0], -1)
+            batch.batch["position_ids"] = position_ids
+            raw_prompt_ids = [normalize_token_ids(ids) for ids in input_ids.tolist()]
+            batch.non_tensor_batch["raw_prompt_ids"] = np.array(raw_prompt_ids, dtype=object)
+
         # pop those keys for generation
         batch_keys_to_pop = ["input_ids", "attention_mask", "position_ids"]
         non_tensor_batch_keys_to_pop = ["raw_prompt_ids"]
-- 
2.43.0


From cf79377c7967da94a4198a357183e849dcfae2c1 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 03:26:58 +0000
Subject: [PATCH 6/8] fix: tokenize prompts individually then pad for batching

apply_chat_template with a list treats it as a single conversation.
Tokenize each prompt individually, then pad to max length.
---
 gkd/megatron/ray_trainer.py | 27 +++++++++++++++++----------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/gkd/megatron/ray_trainer.py b/gkd/megatron/ray_trainer.py
index 0fa11c2..0ecf9e3 100644
--- a/gkd/megatron/ray_trainer.py
+++ b/gkd/megatron/ray_trainer.py
@@ -345,20 +345,27 @@ class OnPolicyDistillTrainer(RayPPOTrainer):
         # If dataset only provides raw_prompt (not pre-tokenized input_ids),
         # tokenize here to produce input_ids/attention_mask for rollout generation.
         if "input_ids" not in batch.batch and "raw_prompt" in batch.non_tensor_batch:
-            raw_prompts = batch.non_tensor_batch["raw_prompt"].tolist()
-            tokenized = self.tokenizer.apply_chat_template(
-                raw_prompts, add_generation_prompt=True, tokenize=True,
-                return_dict=True, return_tensors="pt",
-            )
             from verl.utils.tokenizer import normalize_token_ids
-            input_ids = tokenized["input_ids"]
-            attention_mask = tokenized["attention_mask"]
+            raw_prompts = batch.non_tensor_batch["raw_prompt"].tolist()
+            # Tokenize each prompt individually, then pad to max length
+            all_input_ids = []
+            for rp in raw_prompts:
+                tok = self.tokenizer.apply_chat_template(
+                    rp, add_generation_prompt=True, tokenize=True,
+                )
+                all_input_ids.append(normalize_token_ids(tok))
+            max_len = max(len(ids) for ids in all_input_ids)
+            pad_id = self.tokenizer.pad_token_id or self.tokenizer.eos_token_id or 0
+            input_ids = torch.full((len(all_input_ids), max_len), pad_id, dtype=torch.long)
+            attention_mask = torch.zeros(len(all_input_ids), max_len, dtype=torch.long)
+            for i, ids in enumerate(all_input_ids):
+                input_ids[i, :len(ids)] = torch.tensor(ids, dtype=torch.long)
+                attention_mask[i, :len(ids)] = 1
+            position_ids = torch.arange(max_len).unsqueeze(0).expand(len(all_input_ids), -1)
             batch.batch["input_ids"] = input_ids
             batch.batch["attention_mask"] = attention_mask
-            position_ids = torch.arange(input_ids.shape[1]).unsqueeze(0).expand(input_ids.shape[0], -1)
             batch.batch["position_ids"] = position_ids
-            raw_prompt_ids = [normalize_token_ids(ids) for ids in input_ids.tolist()]
-            batch.non_tensor_batch["raw_prompt_ids"] = np.array(raw_prompt_ids, dtype=object)
+            batch.non_tensor_batch["raw_prompt_ids"] = np.array([ids for ids in all_input_ids], dtype=object)
 
         # pop those keys for generation
         batch_keys_to_pop = ["input_ids", "attention_mask", "position_ids"]
-- 
