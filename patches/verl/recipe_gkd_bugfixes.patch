From f7903c31aa177167e899166e3875202c0d6600d3 Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 02:37:02 +0000
Subject: [PATCH 1/8] fix: rebuild OmegaConf structure after Ray serialization

Ray serializes nested OmegaConf DictConfigs to plain dicts, causing
ConfigAttributeError for any attribute-style access (config.actor.foo).
Rebuild OmegaConf via to_container + create at the Ray actor entry
point, fixing ALL dict-vs-struct mismatches for sub-config access.
---
 gkd/megatron/main_gkd.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/gkd/megatron/main_gkd.py b/gkd/megatron/main_gkd.py
index b94e13e..f8ba8ae 100644
--- a/gkd/megatron/main_gkd.py
+++ b/gkd/megatron/main_gkd.py
@@ -122,6 +122,10 @@ class TaskRunner:
 
         pprint(OmegaConf.to_container(config, resolve=True))
 
+        # Ray serialization converts nested OmegaConf DictConfig → plain dict.
+        # Restore OmegaConf structure so attribute access (config.actor.foo)
+        # works in downstream worker init code.
+        config = OmegaConf.create(OmegaConf.to_container(config, resolve=False))
         OmegaConf.resolve(config)
 
         # Download the checkpoint from HDFS to the local machine.
-- 
2.43.0


