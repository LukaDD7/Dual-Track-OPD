From 6fc801107dd10c9e60e75f0db8a12f597576079b Mon Sep 17 00:00:00 2001
From: LukaDD7 <LukaDD7@users.noreply.github.com>
Date: Fri, 10 Jul 2026 03:37:36 +0000
Subject: [PATCH 7/8] fix: use ServerAdapter.update_weights for vLLM weight
 sync

Modern verl uses ServerAdapter (client-server pattern) instead of
direct inference_engine access. Add detection for ServerAdapter
and use its async update_weights via IPC for model weight syncing.
Fall back to direct engine access for older vLLM setups.
---
 gkd/megatron/megatron_workers.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/gkd/megatron/megatron_workers.py b/gkd/megatron/megatron_workers.py
index 94f1979..f7065a4 100644
--- a/gkd/megatron/megatron_workers.py
+++ b/gkd/megatron/megatron_workers.py
@@ -786,7 +786,10 @@ class MegatronOnPolicyDistillRolloutWorker(ActorRolloutRefWorker):
         assert self._is_rollout and not self.config.hybrid_engine
         assert hasattr(self, "_weights_info") and self._weights_info is not None
         rollout_name = self.config.rollout.name
-        if rollout_name == "vllm":
+        # Use ServerAdapter API for modern vLLM (client-server pattern).
+        # Fall back to direct engine access for older vLLM versions.
+        _use_server_adapter = rollout_name == "vllm" and hasattr(self.rollout, "update_weights")
+        if rollout_name == "vllm" and not _use_server_adapter:
             inference_model = (
                 self.rollout.inference_engine.llm_engine.model_executor.driver_worker.worker.model_runner.model
             )
@@ -840,7 +843,12 @@ class MegatronOnPolicyDistillRolloutWorker(ActorRolloutRefWorker):
 
         for tensors in group_tensor_generator():
             if rollout_name == "vllm":
-                inference_model.load_weights(tensors)
+                if _use_server_adapter:
+                    # ServerAdapter uses async update_weights via IPC
+                    loop = asyncio.get_event_loop_policy().get_event_loop()
+                    loop.run_until_complete(self.rollout.update_weights(tensors))
+                else:
+                    inference_model.load_weights(tensors)
             elif rollout_name == "sglang":
                 loop.run_until_complete(update_weights(inference_model, tensors))
 
-- 
2.43.0


