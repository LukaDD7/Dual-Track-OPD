+def _has_fc_opd_tensors(micro_batch: dict[str, torch.Tensor]) -> bool:
+    required = ("fc_teacher_topk_indices", "fc_teacher_topk_log_probs", "fc_condition_weights")
+    present = [key in micro_batch for key in required]
+    if any(present) and not all(present):
+        missing = [key for key, is_present in zip(required, present) if not is_present]
+        raise RuntimeError(f"incomplete FC-OPD tensor set; missing: {missing}")
+    return all(present)
+
+
+def _compute_fc_opd_sparse_kd(*, student_logits, micro_batch, response_mask, config):
+    fc_config = config.get("fc_opd", {})
+    return compute_verl_sparse_topk_kd(
+        student_logits=student_logits,
+        teacher_topk_indices=micro_batch["fc_teacher_topk_indices"],
+        teacher_topk_log_probs=micro_batch["fc_teacher_topk_log_probs"],
+        teacher_tail_log_prob=micro_batch.get("fc_teacher_tail_log_prob", None),
+        condition_weights=micro_batch["fc_condition_weights"],
+        response_mask=response_mask,
+        renormalize_topk=bool(fc_config.get("renormalize_topk", True)),
+        include_tail=bool(fc_config.get("include_tail", True)),
+        eps=float(fc_config.get("eps", 1e-8)),
+    )
+
+
+def _response_logits_from_rmpad(*, logits_rmpad, indices, batch_size, seqlen, response_length, response_mask):
+    device = logits_rmpad.device
+    response_positions = torch.arange(seqlen - response_length - 1, seqlen - 1, device=device)
+    batch_offsets = torch.arange(batch_size, device=device).unsqueeze(1) * seqlen
+    response_flat_positions = batch_offsets + response_positions.unsqueeze(0)
+    inverse_indices = torch.full((batch_size * seqlen,), -1, dtype=torch.long, device=device)
+    inverse_indices[indices] = torch.arange(indices.numel(), dtype=torch.long, device=device)
+    response_rows = inverse_indices[response_flat_positions]
+    if torch.any((response_rows < 0) & response_mask.bool()):
+        raise RuntimeError("FC-OPD response logits are not aligned with remove-padding indices")
+    return logits_rmpad[response_rows.clamp_min(0)]
+
+
+def _fc_opd_config_float(config, key: str, default: float) -> float:
+    fc_config = config.get("fc_opd", {})
+    return float(fc_config.get(key, default))
