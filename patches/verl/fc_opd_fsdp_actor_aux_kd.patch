+def _response_logits_from_rmpad(*, logits_rmpad, indices, batch_size, seqlen, response_length, response_mask):
+    device = logits_rmpad.device
+    response_positions = torch.arange(seqlen - response_length - 1, seqlen - 1, device=device)
+    batch_offsets = torch.arange(batch_size, device=device).unsqueeze(1) * seqlen
+    response_flat_positions = batch_offsets + response_positions.unsqueeze(0)
+    inverse_indices = torch.full((batch_size * seqlen,), -1, dtype=torch.long, device=device)
+    inverse_indices[indices] = torch.arange(indices.numel(), dtype=torch.long, device=device)
+    response_rows = inverse_indices[response_flat_positions]
+    if torch.any((response_rows < 0) & response_mask.bool()):
+        raise RuntimeError("FC/VA-OPD response logits are not aligned with remove-padding indices")
+    return logits_rmpad[response_rows.clamp_min(0)]
+
+
+def _fc_opd_config_float(config, key: str, default: float) -> float:
+    getter = getattr(config, "get", None)
+    fc_config = getter("fc_opd", {}) if callable(getter) else getattr(config, "fc_opd", {})
+    if not fc_config:
+        return default
+    fc_getter = getattr(fc_config, "get", None)
+    if callable(fc_getter):
+        return float(fc_getter(key, default))
+    return float(getattr(fc_config, key, default))
+
+
+def _fc_opd_loss_mode(batch_fields):
+    raw = batch_fields.get("fc_opd_loss_mode", "forward")
+    if hasattr(raw, "flat"):
+        raw = raw.flat[0]
+    elif isinstance(raw, (list, tuple)):
+        raw = raw[0]
+    return str(raw)
+
+
+def _fc_opd_metric_float(value):
+    if isinstance(value, (int, float)):
+        return float(value)
+    if hasattr(value, "detach"):
+        return float(value.detach().cpu().item())
+    return float(value)
